{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Link to the version of the schema that can validate the resume"
    },
    "basics": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "e.g. Web Developer"
        },
        "image": {
          "type": "string",
          "description": "URL (as per RFC 3986) to a image in JPEG or PNG format"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "description": "e.g. thomas@gmail.com"
        },
        "phone": {
          "type": "string",
          "description": "Phone numbers are stored as strings so use any format you like, e.g. 712-117-2923"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL (as per RFC 3986) to your website, e.g. personal homepage"
        },
        "location": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "description": "To add multiple address lines, use \\n. For example, 1234 Glücklichkeit Straße\\nHinterhaus 5. Etage li."
            },
            "postalCode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "countryCode": {
              "type": "string",
              "description": "code as per ISO-3166-1 ALPHA-2, e.g. US, AU, IN"
            },
            "region": {
              "type": "string",
              "description": "The general region where you live. Can be a US state, or a province, for instance."
            }
          },
          "additionalProperties": {}
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "network": {
                "type": "string",
                "description": "e.g. Facebook or Twitter"
              },
              "networkIcon": {
                "type": "string",
                "description": "e.g. github.svg"
              },
              "username": {
                "type": "string",
                "description": "e.g. neutralthoughts"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "e.g. https://twitter.example.com/neutralthoughts"
              }
            },
            "additionalProperties": {}
          },
          "description": "Specify any number of social networks that you participate in"
        }
      },
      "additionalProperties": {}
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the resume"
          },
          "lead": {
            "type": "string",
            "description": "A lead"
          },
          "description": {
            "type": "string",
            "description": "The heading text"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The tags to select in work, highlight, ..."
          }
        },
        "required": [
          "title",
          "lead"
        ]
      },
      "description": "Project profile"
    },
    "characteristics": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the card"
          },
          "image": {
            "type": "string",
            "description": "The image of the card"
          },
          "image_height": {
            "type": "number",
            "description": "The height of the image in em. It's more a ratio so that all icons have the same visual height"
          },
          "description": {
            "type": "string",
            "description": "The description of the card"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The tags to select in work, highlight, ..."
          }
        },
        "required": [
          "title"
        ]
      },
      "description": "Cards"
    },
